<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.example.homarr-hermes.MODE</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>-c</string><string>set -a; . 'ABSOLUTE_PRIVATE_ENV_FILE'; set +a; exec "$HERMES_MANAGED_PYTHON" 'ABSOLUTE_PACKAGE_DIR/service_runner.py' MODE</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>Umask</key><integer>63</integer>
</dict></plist>
