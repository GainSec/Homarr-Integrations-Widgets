# Copy to private config.env; chmod600. Load with set -a; . ./config.env; set +a.
# Existing personal profile, shared by your Discord Hermes. Do not create a new profile.
HERMES_HOME=$HOME/.hermes
HERMES_REPO=$HOME/.hermes/hermes-agent
# Resolve the managed interpreter used by your installed Hermes launcher.
HERMES_MANAGED_PYTHON=/absolute/path/to/managed/python3
API_SERVER_KEY=<INDEPENDENT_RANDOM_API_TOKEN_AT_LEAST_32_CHARACTERS>
HOMARR_CHAT_TOKEN=<INDEPENDENT_RANDOM_BRIDGE_TOKEN_AT_LEAST_32_CHARACTERS>
HERMES_API_PORT=18642
HOMARR_CHAT_HOST=127.0.0.1
HOMARR_CHAT_PORT=18084
HOMARR_CHAT_ALLOWED_IPS=127.0.0.1,::1
HOMARR_CHAT_ORIGINS=https://dashboard.example.net
HOMARR_CHAT_INSTANCE=Personal-Hermes
