diff --git a/apps/nextjs/src/components/assistant/assistant-guest-widget.tsx b/apps/nextjs/src/components/assistant/assistant-guest-widget.tsx
new file mode 100644
index 00000000..73881d12
--- /dev/null
+++ b/apps/nextjs/src/components/assistant/assistant-guest-widget.tsx
@@ -0,0 +1,202 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import type { FormEvent } from "react";
+import { useRequiredBoard } from "@homarr/boards/context";
+import styles from "./assistant-guest-widget.module.css";
+
+type Message = { role: "user" | "assistant"; content: string };
+
+export function GuestAssistantBoardWidget() {
+  const board = useRequiredBoard();
+  const endpoint = `/api/assistant/guest/${encodeURIComponent(board.id)}`;
+  const storageKey = `homarr.guest-chat.${board.id}`;
+  const [messages, setMessages] = useState<Message[]>([]);
+  const [input, setInput] = useState("");
+  const [ready, setReady] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const controller = useRef<AbortController | null>(null);
+  const end = useRef<HTMLDivElement>(null);
+  const restored = useRef(false);
+
+  useEffect(() => {
+    let active = true;
+    try {
+      const saved: unknown = JSON.parse(sessionStorage.getItem(storageKey) ?? "[]");
+      if (Array.isArray(saved))
+        setMessages(
+          saved
+            .filter(
+              (m): m is Message => m && (m.role === "user" || m.role === "assistant") && typeof m.content === "string",
+            )
+            .slice(-20),
+        );
+    } catch {
+      /* Storage may be disabled. Chat still works in memory. */
+    }
+    restored.current = true;
+    void fetch(endpoint, { cache: "no-store" })
+      .then(async (response) => {
+        if (!active) return;
+        if (response.ok) setReady(true);
+        else {
+          const body = await response.json();
+          setError(body.error ?? "Guest Assistant is unavailable.");
+        }
+      })
+      .catch(() => {
+        if (active) setError("Unable to connect. Reload to try again.");
+      });
+    return () => {
+      active = false;
+      controller.current?.abort();
+    };
+  }, [endpoint, storageKey]);
+
+  useEffect(() => {
+    if (restored.current) {
+      try {
+        sessionStorage.setItem(storageKey, JSON.stringify(messages.slice(-20)));
+      } catch {
+        /* Optional storage. */
+      }
+    }
+    end.current?.scrollIntoView({ block: "nearest" });
+  }, [messages, storageKey]);
+
+  async function send(event: FormEvent) {
+    event.preventDefault();
+    const content = input.trim();
+    if (!content || busy || !ready) return;
+    const history: Message[] = [
+      ...messages
+        .filter((m) => m.content.trim())
+        .slice(-19)
+        .map((m) => ({ ...m, content: m.content.slice(0, 2000) })),
+      { role: "user", content },
+    ];
+    setMessages([...history, { role: "assistant", content: "" }]);
+    setInput("");
+    setError(null);
+    setBusy(true);
+    const abort = new AbortController();
+    controller.current = abort;
+    try {
+      const response = await fetch(endpoint, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ messages: history }),
+        signal: abort.signal,
+      });
+      if (!response.ok) {
+        const body = await response.json();
+        throw new Error(body.error ?? "Unable to send this message.");
+      }
+      if (!response.body) throw new Error("The model returned an empty response.");
+      const reader = response.body.getReader();
+      const decoder = new TextDecoder();
+      let answer = "";
+      for (;;) {
+        const next = await reader.read();
+        if (abort.signal.aborted) return;
+        if (next.done) break;
+        answer += decoder.decode(next.value, { stream: true });
+        setMessages([...history, { role: "assistant", content: answer }]);
+      }
+      if (abort.signal.aborted) return;
+      answer += decoder.decode();
+      if (!answer.trim()) throw new Error("The model returned no text. Please try again.");
+      setMessages([...history, { role: "assistant", content: answer }]);
+    } catch (cause) {
+      if (!abort.signal.aborted)
+        setError(cause instanceof Error ? cause.message : "Connection interrupted. Please try again.");
+    } finally {
+      if (controller.current === abort) {
+        controller.current = null;
+        setBusy(false);
+      }
+    }
+  }
+
+  function clear() {
+    controller.current?.abort();
+    controller.current = null;
+    setBusy(false);
+    setMessages([]);
+    setError(null);
+  }
+
+  return (
+    <section className={styles.panel} data-board-widget="true" aria-label="Guest Assistant" aria-busy={busy}>
+      <header className={styles.header}>
+        <strong>
+          Assistant <span className={styles.badge}>Guest</span>
+        </strong>
+        <button type="button" onClick={clear} aria-label="Start a new guest chat">
+          New chat
+        </button>
+      </header>
+      <div
+        className={styles.messages}
+        role="log"
+        aria-label="Conversation"
+        aria-live="polite"
+        aria-relevant="additions text"
+      >
+        {messages.length === 0 && (
+          <div className={styles.welcome}>
+            <strong>How can I help?</strong>
+            <p>Ask a question without signing in.</p>
+            <small>This chat stays in this browser tab. Guest chat cannot control your services.</small>
+          </div>
+        )}
+        {messages.map((message, index) => (
+          <article key={index} className={message.role === "user" ? styles.user : styles.assistant}>
+            <small>{message.role === "user" ? "You" : "Assistant"}</small>
+            <div>{message.content || (busy ? "Thinking…" : "No response")}</div>
+          </article>
+        ))}
+        <div ref={end} />
+      </div>
+      {error && (
+        <div role="alert" className={styles.error}>
+          {error}
+        </div>
+      )}
+      <form onSubmit={send} className={styles.composer}>
+        <label htmlFor={`guest-prompt-${board.id}`} className={styles.label}>
+          Message Assistant
+        </label>
+        <textarea
+          id={`guest-prompt-${board.id}`}
+          aria-label="Message guest Assistant"
+          placeholder={ready ? "Ask Assistant…" : "Connecting…"}
+          value={input}
+          maxLength={2000}
+          rows={2}
+          disabled={!ready}
+          onChange={(event) => setInput(event.currentTarget.value)}
+          onKeyDown={(event) => {
+            if (event.key === "Enter" && !event.shiftKey && !event.nativeEvent.isComposing) {
+              event.preventDefault();
+              event.currentTarget.form?.requestSubmit();
+            }
+          }}
+        />
+        <footer>
+          <small>Guest chat · no service controls</small>
+          {busy ? (
+            <button type="button" onClick={() => controller.current?.abort()}>
+              Stop
+            </button>
+          ) : (
+            <button type="submit" disabled={!ready || !input.trim()}>
+              Send ↑
+            </button>
+          )}
+        </footer>
+      </form>
+    </section>
+  );
+}
