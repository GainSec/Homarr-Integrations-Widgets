--- /dev/null
+++ b/apps/nextjs/src/app/api/assistant/guest/[boardId]/route.ts
@@ -0,0 +1,143 @@
+import { createOpenAICompatible } from "@ai-sdk/openai-compatible";
+import { streamText } from "ai";
+import { cookies } from "next/headers";
+import { z } from "zod/v4";
+import { decryptSecret, resolveRequestIdentity } from "@homarr/common/server";
+import { and, db, eq } from "@homarr/db";
+import { assistantConfigurations, boards, items } from "@homarr/db/schema";
+import { readAssistantRequestBodyAsync } from "../../chat/assistant-request-body";
+import {
+  createVisitorToken,
+  GuestBudget,
+  isGuestBoardAllowed,
+  validateMessages,
+  validateVisitorToken,
+} from "../policy";
+
+export const dynamic = "force-dynamic";
+const budget = new GuestBudget();
+const cookieName = "homarr.guest-assistant";
+const noStore = { "Cache-Control": "no-store" };
+const error = (message: string, status: number) => Response.json({ error: message }, { status, headers: noStore });
+type Context = { params: Promise<{ boardId: string }> };
+
+async function allowed(boardId: string) {
+  if (process.env.HOMARR_GUEST_ASSISTANT !== "true" || boardId.length > 128) return false;
+  const board = await db.query.boards.findFirst({ where: eq(boards.id, boardId), columns: { isPublic: true } });
+  const placement = board?.isPublic
+    ? await db.query.items.findFirst({
+        where: and(eq(items.boardId, boardId), eq(items.kind, "assistant")),
+        columns: { id: true },
+      })
+    : null;
+  return isGuestBoardAllowed(true, !!board?.isPublic, !!placement);
+}
+
+export async function GET(_request: Request, context: Context) {
+  const { boardId } = await context.params;
+  if (!(await allowed(boardId))) return error("Guest Assistant is not enabled for this board.", 404);
+  const configuration = await db.query.assistantConfigurations.findFirst({
+    where: eq(assistantConfigurations.id, "default"),
+  });
+  if (!configuration?.enabled || !configuration.modelId || configuration.provider !== "custom") {
+    return error("Guest Assistant requires an enabled custom model provider.", 503);
+  }
+  const secret = process.env.SECRET_ENCRYPTION_KEY;
+  if (!secret) return error("Guest Assistant is unavailable.", 503);
+  const jar = await cookies();
+  if (!validateVisitorToken(jar.get(cookieName)?.value, secret)) {
+    jar.set(cookieName, createVisitorToken(secret), {
+      httpOnly: true,
+      sameSite: "strict",
+      path: "/api/assistant/guest",
+      maxAge: 86400,
+    });
+  }
+  return Response.json({ enabled: true }, { headers: noStore });
+}
+
+export async function POST(request: Request, context: Context) {
+  const { boardId } = await context.params;
+  if (!(await allowed(boardId))) return error("Guest Assistant is not enabled for this board.", 404);
+  const origin = request.headers.get("origin");
+  try {
+    if (!origin || new URL(origin).host !== request.headers.get("host"))
+      return error("Use chat from this dashboard.", 403);
+  } catch {
+    return error("Use chat from this dashboard.", 403);
+  }
+  const secret = process.env.SECRET_ENCRYPTION_KEY;
+  const visitor = (await cookies()).get(cookieName)?.value;
+  if (!secret || !visitor || !validateVisitorToken(visitor, secret)) return error("Reload the guest chat first.", 401);
+  const release = budget.acquire(resolveRequestIdentity(request.headers).key, visitor);
+  if (!release) return error("Chat is busy. Please try again in a minute.", 429);
+  try {
+    const raw = await readAssistantRequestBodyAsync(request, 32768);
+    if (raw === null) {
+      release();
+      return error("This conversation is too large. Start a new chat.", 413);
+    }
+    let body: unknown;
+    try {
+      body = JSON.parse(raw);
+    } catch {
+      release();
+      return error("Invalid chat request.", 400);
+    }
+    const parsed = z.object({ messages: z.unknown() }).safeParse(body);
+    if (!parsed.success || !validateMessages(parsed.data.messages)) {
+      release();
+      return error("Send up to 20 text messages, at most 2000 characters each.", 400);
+    }
+    const configuration = await db.query.assistantConfigurations.findFirst({
+      where: eq(assistantConfigurations.id, "default"),
+    });
+    if (!configuration?.enabled || !configuration.modelId || configuration.provider !== "custom") {
+      release();
+      return error("Guest Assistant is unavailable.", 503);
+    }
+    const headers = configuration.encryptedHeaders
+      ? z.record(z.string(), z.string()).parse(JSON.parse(decryptSecret(configuration.encryptedHeaders)))
+      : {};
+    const provider = createOpenAICompatible({
+      name: "homarr-guest",
+      baseURL: configuration.baseUrl,
+      apiKey: configuration.encryptedApiKey ? decryptSecret(configuration.encryptedApiKey) : undefined,
+      headers,
+    });
+    const result = streamText({
+      model: provider(configuration.modelId),
+      system:
+        "You are the guest Assistant on the shared dashboard. Be helpful and concise. You have no tools, no access to Homarr management, connected services, private information, or other visitors’ chats. Do not claim to inspect or change devices or dashboards.",
+      messages: parsed.data.messages,
+      maxOutputTokens: 1024,
+      abortSignal: AbortSignal.any([request.signal, AbortSignal.timeout(90000)]),
+    });
+    const source = result.textStream[Symbol.asyncIterator]();
+    const encoder = new TextEncoder();
+    const stream = new ReadableStream<Uint8Array>({
+      async pull(controller) {
+        try {
+          const next = await source.next();
+          if (next.done) {
+            release();
+            controller.close();
+          } else controller.enqueue(encoder.encode(next.value));
+        } catch {
+          release();
+          controller.error(new Error("The model connection failed. Please try again."));
+        }
+      },
+      async cancel() {
+        release();
+        await source.return?.();
+      },
+    });
+    return new Response(stream, {
+      headers: { ...noStore, "Content-Type": "text/plain; charset=utf-8", "X-Accel-Buffering": "no" },
+    });
+  } catch {
+    release();
+    return error("The model connection failed. Please try again.", 502);
+  }
+}
