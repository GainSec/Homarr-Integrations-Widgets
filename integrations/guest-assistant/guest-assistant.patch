index 00000000..07e6e8b1
--- /dev/null
+++ b/apps/nextjs/src/app/api/assistant/guest/policy.ts
@@ -0,0 +1,59 @@
+import { createHmac, randomBytes, timingSafeEqual } from "node:crypto";
+
+export const isGuestBoardAllowed = (enabled: boolean, publicBoard: boolean, assistantPlaced: boolean) =>
+  enabled && publicBoard && assistantPlaced;
+
+export function createVisitorToken(secret: string) {
+  const id = randomBytes(24).toString("hex");
+  return `${id}.${createHmac("sha256", secret).update(`guest-assistant:${id}`).digest("hex")}`;
+}
+export function validateVisitorToken(token: string | undefined, secret: string) {
+  if (!token || !/^[a-f0-9]{48}\.[a-f0-9]{64}$/.test(token)) return false;
+  const [id, signature] = token.split(".");
+  const expected = createHmac("sha256", secret).update(`guest-assistant:${id}`).digest("hex");
+  return timingSafeEqual(Buffer.from(signature ?? ""), Buffer.from(expected));
+}
+export type GuestMessage = { role: "user" | "assistant"; content: string };
+export function validateMessages(messages: unknown): messages is GuestMessage[] {
+  return (
+    Array.isArray(messages) &&
+    messages.length > 0 &&
+    messages.length <= 20 &&
+    messages.at(-1)?.role === "user" &&
+    messages.every(
+      (message) =>
+        message &&
+        (message.role === "user" || message.role === "assistant") &&
+        typeof message.content === "string" &&
+        message.content.trim().length > 0 &&
+        message.content.length <= 2000,
+    )
+  );
+}
+
+export class GuestBudget {
+  private windows = new Map<string, { count: number; expires: number }>();
+  private active = 0;
+  acquire(network: string, visitor: string, now = Date.now()): (() => void) | null {
+    for (const [key, window] of this.windows) if (window.expires <= now) this.windows.delete(key);
+    const limits: [string, number][] = [
+      ["global", 60],
+      [`network:${network}`, 10],
+      [`visitor:${visitor}`, 10],
+    ];
+    if (this.active >= 4 || limits.some(([key, limit]) => (this.windows.get(key)?.count ?? 0) >= limit)) return null;
+    for (const [key] of limits) {
+      const window = this.windows.get(key) ?? { count: 0, expires: now + 60000 };
+      window.count++;
+      this.windows.set(key, window);
+    }
+    this.active++;
+    let released = false;
+    return () => {
+      if (!released) {
+        this.active--;
+        released = true;
+      }
+    };
+  }
+}
