[Unit]
Description=Homarr openwrt-gateway read-only collector
After=network-online.target
[Service]
Type=simple
User=homarr-collector
WorkingDirectory=/opt/homarr-openwrt-gateway
EnvironmentFile=/etc/homarr-openwrt-gateway/collector.env
ExecStart=/usr/bin/python3 /opt/homarr-openwrt-gateway/collector.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
