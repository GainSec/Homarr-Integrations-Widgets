# Store real values in /etc/homarr-tailscale/collector.env, chmod 600.
COLLECTOR_BIND=127.0.0.1
COLLECTOR_PORT=18082
# Exact TCP peer addresses of the Homarr server; no CIDR or forwarded headers.
COLLECTOR_ALLOWED_CLIENTS=127.0.0.1
TAILSCALE_BINARY=/usr/bin/tailscale

# Generate a random token as described in INSTALL.md; paste it below.
COLLECTOR_TOKEN=""
