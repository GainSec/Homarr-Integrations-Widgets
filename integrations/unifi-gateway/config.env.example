# Store real values in /etc/homarr-unifi-gateway/collector.env, chmod 600.
COLLECTOR_BIND=127.0.0.1
COLLECTOR_PORT=18086
# Exact TCP peer addresses of the Homarr server; no CIDR or forwarded headers.
COLLECTOR_ALLOWED_CLIENTS=127.0.0.1
UNIFI_ORIGIN=https://app.example.net
UNIFI_SITE=default
UNIFI_CREDENTIALS_FILE=/etc/homarr-unifi-gateway/credentials.json

# Generate a random token as described in INSTALL.md; paste it below.
COLLECTOR_TOKEN=""
